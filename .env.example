# Copie para .env e preencha. Nunca versione o .env.
POSTGRES_DB=emptyvariable
POSTGRES_USER=emptyvariable
POSTGRES_PASSWORD=troque-esta-senha
DATABASE_URL=postgresql://emptyvariable:troque-esta-senha@postgres:5432/emptyvariable

# Portas expostas no host (somente 127.0.0.1)
WEB_PORT=4200
POSTGRES_PORT=55433

# Origem pública do sistema, sem barra no fim. Usada no redirect pós-login e na proteção contra CSRF.
APP_ORIGIN=http://localhost:4200
# Segredo das sessões (mínimo de 32 caracteres). Gere com: openssl rand -base64 48
SESSION_SECRET=
# Cookies com a flag Secure. Deixe "false" só em ambiente local sem HTTPS.
COOKIE_SECURE=false

# Discord OAuth2 (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# ID do servidor do grupo: só membros dele conseguem entrar (D13)
DISCORD_GUILD_ID=
# Opcional. Padrão: ${APP_ORIGIN}/api/auth/discord/callback (cadastre esta URL no portal do Discord)
DISCORD_REDIRECT_URI=
# IDs do Discord (separados por vírgula) que viram ADMIN ao entrar
ADMIN_DISCORD_IDS=

# Opcional. Segredo (32+ caracteres: openssl rand -hex 32) que libera /api/integracao para outros
# sistemas do grupo, como o bot nag4eyes. Vazio deixa a integração desligada.
INTEGRACAO_TOKEN=

# Diário de farm (D53): chave da API da Divine Pride para mostrar o nome do item ao digitar o ID.
# Opcional: sem ela, a busca usa só os itens já conhecidos. As imagens pelo ID não precisam de chave.
# A chave sai do seu perfil no site da Divine Pride. Servidor dos nomes (cabeçalho x-server): bRO,
# em português. Os IDs dos itens são os mesmos do RO LATAM.
DIVINE_PRIDE_API_KEY=
DIVINE_PRIDE_SERVER=bRO

# Login simulado (POST /api/auth/dev-login) para desenvolvimento local. Nunca ative em produção.
AUTH_DEV_LOGIN=false

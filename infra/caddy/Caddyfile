# Caddy na frente de tudo: certificado HTTPS automático (Let's Encrypt) para {$DOMINIO}.
# /api/* vai para a API; o resto é o frontend Angular (nginx do serviço web).
{$DOMINIO} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# D61: o simulador de dano (web/public/simulador-latam) abre num iframe da tela /simulador, na
	# mesma origem. Só ele pode ser emoldurado, e só pelo próprio sistema; o resto continua proibido.
	# Os dois blocos não se sobrepõem, então a ordem entre eles não importa.
	@simulador path /simulador-latam/*
	@resto not path /simulador-latam/*

	header @resto {
		X-Frame-Options "DENY"
		# Angular Material injeta estilos em tempo de execução ('unsafe-inline' só em style-src).
		# Fontes do Google e avatares do Discord são as únicas origens externas.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://cdn.discordapp.com; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://discord.com"
	}
	header @simulador {
		X-Frame-Options "SAMEORIGIN"
		# Mesma política, trocando quem pode emoldurar e as imagens. D61: as únicas origens externas do
		# simulador são as das imagens (ícones e sprites da latam-tools e a figura do item na Divine Pride).
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://assets.latam-tools.com.br https://www.divine-pride.net; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
	}

	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		reverse_proxy web:80
	}

	log {
		output stdout
		format console
	}
}

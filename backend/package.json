{
  "name": "@betel/api",
  "version": "0.1.0",
  "private": true,
  "description": "API NestJS do sistema Betel.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prisma:generate": "prisma generate --schema ../database/prisma/schema.prisma",
    "migrate:deploy": "prisma migrate deploy --schema ../database/prisma/schema.prisma",
    "sso:verificar": "node --env-file-if-exists=../.env dist/verificar-sso.js"
  },
  "dependencies": {
    "@betel/farm": "workspace:*",
    "@betel/motor-latam": "workspace:*",
    "@betel/scoring": "workspace:*",
    "@betel/simulador": "workspace:*",
    "@emptyvariable/discord": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/client": "6.19.3",
    "cookie-parser": "1.4.7",
    "lz-string": "1.5.0",
    "prisma": "6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@swc/core": "^1.10.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "embedded-postgres": "16.15.0-beta.19",
    "supertest": "^7.0.0",
    "unplugin-swc": "^1.5.1",
    "vite": "5.4.21",
    "vitest": "^2.1.8"
  }
}

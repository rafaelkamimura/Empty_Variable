{
  "name": "@betel/farm",
  "version": "0.1.0",
  "private": true,
  "description": "Regras puras do Diário de farm: recarga das instâncias (reset 04:00, UTC-3), períodos e totais.",
  "type": "module",
  "main": "./dist/index.js",

# VPS compartilhada (docker-compose.vps.yml). Copie para .env na raiz do clone da VPS e preencha. Nunca versione.
# Guia: docs/implantacao.md, seção 8.

# Origem pública (só esquema + domínio) e a sub-rota em que o sistema fica nesse domínio.
# Deixe APP_BASE_PATH vazio se o sistema tiver um domínio só para ele.
APP_ORIGIN=https://eyes.exemplo.com
APP_BASE_PATH=/emptyvariable

# Porta local (127.0.0.1) que o nginx do host usa para chegar ao sistema.
WEB_PORT=4200

# Postgres que já roda na VPS: nome do contêiner (ou alias) e a rede Docker dele.
DB_HOST=
DB_PORT=5432
DB_NETWORK=
# Banco e usuário criados nesse Postgres só para este sistema (o usuário precisa de CREATEDB
# para o teste de restauração). Senha sem caracteres especiais de URL: openssl rand -hex 24
POSTGRES_DB=emptyvariable
POSTGRES_USER=emptyvariable
POSTGRES_PASSWORD=

# Sessões: openssl rand -base64 48
SESSION_SECRET=

# Discord OAuth2. Redirect a cadastrar no portal: <APP_ORIGIN><APP_BASE_PATH>/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
# Quem vira admin ao entrar (IDs do Discord, separados por vírgula). Obrigatório para o primeiro acesso.
ADMIN_DISCORD_IDS=

# Opcional. Segredo (32+ caracteres: openssl rand -hex 32) que libera /api/integracao para outros
# sistemas do grupo, como o bot nag4eyes. Vazio deixa a integração desligada.
INTEGRACAO_TOKEN=

# Diário de farm (D53): chave da API da Divine Pride para mostrar o nome do item ao digitar o ID.
# Opcional: sem ela, a busca usa só os itens já conhecidos. As imagens pelo ID não precisam de chave.
# Peça a chave em https://www.divine-pride.net/api . Servidor dos nomes: LATAM.
DIVINE_PRIDE_API_KEY=
DIVINE_PRIDE_SERVER=LATAM

# Backup diário (cron em UTC; 07:00 UTC = 04:00 em Brasília) e quantos manter.
BACKUP_CRON=0 7 * * *
BACKUP_RETENCAO=14
# Pasta no host onde ficam os arquivos de backup.
BACKUP_DIR=./backups

# Produção (docker-compose.prod.yml). Copie para .env.producao na VPS e preencha. Nunca versione.
# Guia: docs/implantacao.md

# Domínio público (o DNS precisa apontar para a VPS antes de subir: o Caddy emite o certificado na hora).
DOMINIO=betel.exemplo.com

# Banco. Use uma senha sem caracteres especiais de URL: openssl rand -hex 24
POSTGRES_DB=emptyvariable
POSTGRES_USER=emptyvariable
POSTGRES_PASSWORD=

# Sessões: openssl rand -base64 48
SESSION_SECRET=

# Discord OAuth2. Redirect a cadastrar no portal: https://<DOMINIO>/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
# Quem vira admin ao entrar (IDs do Discord, separados por vírgula). Obrigatório para o primeiro acesso.
ADMIN_DISCORD_IDS=

# Opcional. Segredo (32+ caracteres: openssl rand -hex 32) que libera /api/integracao para outros
# sistemas do grupo, como o bot nag4eyes. Vazio deixa a integração desligada.
INTEGRACAO_TOKEN=

# Diário de farm (D53): chave da API da Divine Pride para mostrar o nome do item ao digitar o ID.
# Opcional: sem ela, a busca usa só os itens já conhecidos. As imagens pelo ID não precisam de chave.
# A chave sai do seu perfil no site da Divine Pride. Servidor dos nomes (cabeçalho x-server): bRO,
# em português. Os IDs dos itens são os mesmos do RO LATAM.
DIVINE_PRIDE_API_KEY=
DIVINE_PRIDE_SERVER=bRO

# Backup diário (cron em UTC; 07:00 UTC = 04:00 em Brasília) e quantos manter.
BACKUP_CRON=0 7 * * *
BACKUP_RETENCAO=14
# Pasta no host onde ficam os arquivos de backup.
BACKUP_DIR=./backups
